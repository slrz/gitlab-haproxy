backend ssh
    mode tcp
    balance <%= node['gitlab-haproxy']['frontend']['ssh']['balance'] %>
    option splice-auto
    hash-type consistent
    timeout server-fin <%= node['gitlab-haproxy']['timeout_server_fin'] %>
    timeout server <%= node['gitlab-haproxy']['timeout_server_ssh'] %>
    # The default check port is 443 and not 22. The assumption here is that ssh won't work
    # if rails isn't running and they're both running on the same host.
    # We need to change this when we split rails to a separate cluster.
<%= render 'partial_healthcheck.erb', :variables => {:ha_frontend => node['gitlab-haproxy']['frontend']['ssh'], :ha_global => node['gitlab-haproxy']['global'] } -%>
    <% @backend_servers['all']['ssh'].each do |name, ip| %>
    server <%= name %> <%= ip %>:<%= node['gitlab-haproxy']['frontend']['ssh']['server_port'] %> <% if node['gitlab-haproxy']['frontend']['use_weights'] %>weight <%= node['gitlab-haproxy']['frontend']['ssh']['default_weight'] %> <% end %>check <%= node['gitlab-haproxy']['frontend']['ssh']['check_opts'] %> <%= node['gitlab-haproxy']['frontend']['default_check_opts'] %><% if node['gitlab-haproxy']['frontend']['ssh']['tcp_check_enable'] %> check-ssl verify none<% end %><%= @backend_servers['active']['ssh'].key?(name) ? '' : ' backup' %>
    <% end %>
    <% if node['gitlab-haproxy']['frontend']['use_weights'] %>
    <% @backend_servers['all']['canary_ssh'].each do |name, ip| %>
    server <%= name %> <%= ip %>:<%= node['gitlab-haproxy']['frontend']['ssh']['server_port'] %> <% if node['gitlab-haproxy']['frontend']['use_weights'] %>weight <%= node['gitlab-haproxy']['frontend']['canary_ssh']['default_weight'] %> <% end %>check <%= node['gitlab-haproxy']['frontend']['ssh']['check_opts'] %> <%= node['gitlab-haproxy']['frontend']['default_check_opts'] %> check-ssl verify none<%= @backend_servers['active']['canary_ssh'].key?(name) ? '' : ' backup' %>
    <% end %>
    <% end %>

backend websockets
