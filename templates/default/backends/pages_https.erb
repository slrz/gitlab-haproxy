<%= render 'boilerplate/backend_definition.erb', :variables => {
  name: 'pages_https',
  description: 'Targets the pages fleet with a weighted mixin of canary backends via TCP',
  mode: 'tcp',
  health_check: get_attribute('gitlab-haproxy', flavor), # The health_check is one level up for pages
  source_nodes: ['pages'],
  mixin_nodes: ['canary_pages'],
  check_port_override: get_attribute('gitlab-haproxy', flavor, 'http_backend_listen_port') # The Pages backend was not added according to spec, so we need to override the port for the HTTP endpoints for pages.
} -%>
