<%= render 'boilerplate/backend_definition.erb', :variables => {
  name: 'kas_k8s_proxy',
  description: 'Targets the KAS K8s proxy fleet WITHOUT a weighted mixin of canary backends',
  mode: 'http',
  health_check: get_attribute('gitlab-haproxy', flavor, 'kas'),
  override_host: nil,
  source_nodes: ['kas'],
  port_override: get_attribute('gitlab-haproxy', flavor, 'kas', 'proxy_port'), # The KAS backend was not added according to spec, so we need to override the port for the k8s proxys.
  check_port_override: get_attribute('gitlab-haproxy', flavor, 'kas', 'check_port'),
} -%>
