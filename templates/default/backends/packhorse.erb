<%- packhorse_namespace = get_attribute('gitlab-haproxy', 'ci-gateway', 'enabled') ? 'ci-gateway' : 'frontend' -%>
<%- packhorse_host = get_attribute('gitlab-haproxy', packhorse_namespace, 'packhorse_host') -%>
<%- source_iface = get_attribute('gitlab-haproxy', packhorse_namespace, 'packhorse_source_interface') -%>
<%- source_ip = source_iface && (get_attribute('network', 'interfaces', source_iface, 'addresses') || {}).find { |_addr, props| props['family'] == 'inet' }&.first -%>
#### Backend packhorse (flavor <%= flavor %>)
backend packhorse
  mode http
  timeout server 1h
<% if source_ip %>
  default-server source <%= source_ip %>
<% end %>
<% unless packhorse_host.nil? || packhorse_host.empty? %>
  server packhorse_lb <%= packhorse_host %>:8080 check
<% end %>
