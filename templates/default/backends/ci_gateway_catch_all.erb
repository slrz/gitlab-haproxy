<%= render 'boilerplate/backend_definition.erb', :variables => {
  name: 'ci_gateway_catch_all',
  description: 'Redirects all requests to the matching GitLab.com URI',
  mode: 'http',
} -%>

  # Code 307 is important as it hints to the client to redirect keeping the original method,
  # necessary for requests like POST /api/v4/jobs/:id/artifacts which will not be captured by the frontend.
  <% redirect_uri = "https://#{get_attribute('gitlab-haproxy', 'frontend', 'canonical_host')}%[capture.req.uri]" %>
  http-request redirect code 307 location <%= redirect_uri %>
