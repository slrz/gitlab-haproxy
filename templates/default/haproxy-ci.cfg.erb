global
    log /dev/log len 4096 local0
    log /dev/log len 4096 local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin
    stats socket ipv4@<%= node['gitlab-haproxy']['api_address'] %>:23646 level admin
    stats timeout 30s
    user haproxy
    group haproxy
    daemon
    maxconn 50000
    spread-checks 2
    nbproc 1
    nbthread <%= node['gitlab-haproxy']['global']['nbthread'] %>
<% if node['gitlab-haproxy']['global']['hard-stop']['enable'] %>
    hard-stop-after <%= node['gitlab-haproxy']['global']['hard-stop']['timeout'] %>
<% end %>
<% if node['gitlab-haproxy']['systemd_service_overrides']['enable'] %>
    server-state-file /etc/haproxy/state/global
<% end %>

    # Default SSL material locations
    ca-base /etc/ssl/certs
    crt-base /etc/ssl/private

    # Default ciphers to use on SSL-enabled listening sockets.
    # For more information, see ciphers(1SSL).
    ssl-default-bind-ciphers <%= node['gitlab-haproxy']['global']['ssl-default-bind-ciphers'] %>
<% unless node['gitlab-haproxy']['global']['ssl-default-bind-options'].nil? %>
    ssl-default-bind-options <%= node['gitlab-haproxy']['global']['ssl-default-bind-options'] %>
<% end %>
    # Keep DH params size at 1024 for Java 6 HTTPS clients
    tune.ssl.default-dh-param 1024

defaults
    log global
    option dontlognull
    # Use all backup servers
    # instead of just the first one
    # if other servers are down
    option allbackups
    maxconn 50000
    timeout connect <%= node['gitlab-haproxy']['timeout_connect'] %>
    timeout check <%= node['gitlab-haproxy']['timeout_check'] %>
    timeout client <%= node['gitlab-haproxy']['timeout_client'] %>
    timeout server <%= node['gitlab-haproxy']['timeout_server'] %>
    errorfile 400 /etc/haproxy/errors/400.http
    errorfile 403 /etc/haproxy/errors/403.http
    errorfile 408 /etc/haproxy/errors/400.http
    errorfile 429 /etc/haproxy/errors/429.http
    errorfile 500 /etc/haproxy/errors/500.http
    errorfile 502 /etc/haproxy/errors/502.http
    errorfile 503 /etc/haproxy/errors/503.http
    errorfile 504 /etc/haproxy/errors/504.http
<% if node['gitlab-haproxy']['systemd_service_overrides']['enable'] %>
    load-server-state-from-file global
<% end %>

listen stats
    bind <%= node['gitlab-haproxy']['listen_address'] %>:7331
    mode http
    stats enable
    stats hide-version
    stats realm Haproxy\ Statistics
    stats uri /
    stats auth admin:<%= @admin_password %>
    stats admin if TRUE

#---------------------------------------------------------------------
# Frontend configuration
#---------------------------------------------------------------------
frontend https
    bind <%= node['gitlab-haproxy']['listen_address'] %>:443 ssl crt /etc/haproxy/ssl/ci.pem
    mode http
    option splice-auto
    timeout client-fin <%= node['gitlab-haproxy']['timeout_client_fin'] %>
    log-format %ci:%cp\ [%t]\ %ft\ %sslv\ %b/%s\ %Tq/%Tw/%Tc/%Tr/%Tt\ %ST\ %B\ %U\ %CC\ %CS\ %tsc\ %ac/%fc/%bc/%sc/%rc\ %sq/%bq\ %hr\ %hs\ %{+Q}r
    capture request header User-Agent len 64

    ###############################################################
    # CI API ACLs
    # HAProxy will OR these invocations

    acl is_api_method method POST PATCH PUT
    ### POST PATCH PUT Rules
    # POST for register runner
    acl is_ci_api path_reg -i ^\/api\/v4\/runners$
    # POST to get job
    acl is_ci_api path_reg -i ^\/api\/v4\/jobs\/request$
    # POST for runner verification
    acl is_ci_api path_reg -i ^\/api\/v4\/runners\/verify$
    # PATCH for job traces
    acl is_ci_api path_reg -i ^\/api\/v4\/jobs\/\d+\/trace$
    # PUT for job status etc
    acl is_ci_api path_reg -i ^\/api\/v4\/jobs\/\d+$
    # GET/POST for build artifacts (note, no end match here!)
    acl is_ci_api path_reg -i ^\/api\/v4\/jobs\/\d+/artifacts

    acl is_api_get_method method GET
    ### GET Rules
    # GET to get jobs
    acl is_ci_api_get path_reg -i ^\/api\/v4\/jobs$
    # GET/POST for build artifacts (note, no end match here!)
    acl is_ci_api_get path_reg -i ^\/api\/v4\/jobs\/\d+/artifacts
    ###############################################################

    ###############################################################
    # HTTPS git ACLs
    # HAProxy will OR these acl conditions
    acl is_https_git path_reg -i ^\/[^\/]+(\/[^\/]+)+\.git$
    acl is_https_git path_reg -i ^\/[^\/]+(\/[^\/]+)+\.git\/info\/refs$
    acl is_https_git path_reg -i ^\/[^\/]+(\/[^\/]+)+\.git\/info\/refs\?service=git-(upload|receive)-pack$
    acl is_https_git path_reg -i ^\/[^\/]+(\/[^\/]+)+\.git\/git-(upload|receive)-pack$
    acl is_https_git path_reg -i ^\/[^\/]+(\/[^\/]+)+\.git\/objects\/[^\/]{2}\/[^\/]{14,}$
    acl is_git_method method GET POST
    ###############################################################

    ###############################################################
    # Canary ACLs
    acl no_be_srvs_canary_https_git nbsrv(canary_ci_https_git) lt 1
    acl no_be_srvs_canary_api nbsrv(canary_ci_api) lt 1
    acl is_canary_path path_beg -f /etc/haproxy/canary-request-paths.lst
    ###############################################################

<%if node['gitlab-haproxy']['ci']['enable_fallback'] == true %>
    ###############################################################
    # Fallback ACLs
    acl git_fallback path_reg -i ^\/[^\/]+(\/[^\/]+)+\.git
    acl api_fallback path_reg -i ^\/api
    ###############################################################
<% end %>

    http-request set-var(txn.host) hdr(Host)
    http-request set-header X-Forwarded-Proto https
    http-request set-header X-SSL %[ssl_fc]
    http-response set-header GitLab-LB <%= node['hostname'] %>
    http-response set-header GitLab-SV %s

    acl blacklist-uri path_beg -i -f /etc/haproxy/blacklist-uris.lst
    http-request deny if blacklist-uri

    ###############################################################
    # HTTPS GIT routing
<% if node['gitlab-haproxy']['ci']['canary_https_git']['enable'] %>
    # If it is an https git request and there are no healthy canary
    # servers, route request to the https_git backend
    use_backend ci_https_git if is_https_git is_git_method no_be_srvs_canary_https_git

    # Use the canary for internal request paths like /gitlab-com/
    use_backend canary_ci_https_git if is_https_git is_git_method is_canary_path

    # Finally, if no canary rules match, route requests to the normal
    # https_git backend
<% end %>
    use_backend ci_https_git if is_https_git is_git_method
    ###############################################################

    ###############################################################
    # API routing
<% if node['gitlab-haproxy']['ci']['canary_api']['enable'] %>
    # If there are no healthy canary servers default to the api backend
    use_backend ci_api if is_ci_api is_api_method no_be_srvs_canary_api
    use_backend ci_api if is_ci_api_get is_api_get_method no_be_srvs_canary_api

    # Use the canary for internal request paths like /gitlab-com/, unless
    # the cookie gitlab_canary=false is set
    use_backend canary_ci_api if is_ci_api is_api_method is_canary_path
    use_backend canary_ci_api if is_ci_api_get is_api_get_method is_canary_path

    # Finally, if no canary rules match, route requests to the normal
    # api backend
<% end %>
    use_backend ci_api if is_ci_api is_api_method
    use_backend ci_api if is_ci_api_get is_api_get_method
    ###############################################################

<%if node['gitlab-haproxy']['ci']['enable_fallback'] == true %>
    ###############################################################
    # Fallback routing
    ## Fallback mode is enabled, so any unmatched action will still be routed.
    use_backend fallback_ci_https_git if git_fallback
    use_backend fallback_ci_api if api_fallback
    ###############################################################

<% end %>
    default_backend return_403

frontend check_https
    bind <%= node['gitlab-haproxy']['listen_address'] %>:8002
    mode http
    option splice-auto
    acl no_be_srvs_https_git nbsrv(ci_https_git) lt 1
    acl no_be_srvs_api nbsrv(ci_api) lt 1
    monitor-uri /-/available-https
    monitor fail if no_be_srvs_https_git || no_be_srvs_api

#---------------------------------------------------------------------
# Backend configuration
#---------------------------------------------------------------------
backend return_403
    mode http
    http-request deny

backend ci_api
    mode http
    balance roundrobin
    option forwardfor
    option splice-auto
    timeout server-fin <%= node['gitlab-haproxy']['timeout_server_fin'] %>
<%= render 'partial_healthcheck.erb', :variables => {:ha_frontend => node['gitlab-haproxy']['ci']['api'], :ha_global => node['gitlab-haproxy']['global'] } -%>
<% @backend_servers['all']['api'].each do |name, ip| %>
    server <%= name %> <%= ip %>:443 <% if node['gitlab-haproxy']['ci']['use_weights'] %>weight <%= node['gitlab-haproxy']['ci']['api']['default_weight'] %> <% end %>check <%= node['gitlab-haproxy']['ci']['api']['check_opts'] %> <%= node['gitlab-haproxy']['ci']['default_check_opts'] %> ssl verify none<%= @backend_servers['active']['api'].key?(name) ? '' : ' backup' %>
<% end %>
<% if node['gitlab-haproxy']['ci']['use_weights'] %>
<% @backend_servers['all']['canary_api'].each do |name, ip| %>
    server <%= name %> <%= ip %>:443 <% if node['gitlab-haproxy']['ci']['use_weights'] %>weight <%= node['gitlab-haproxy']['ci']['canary_api']['default_weight'] %> <% end %>check <%= node['gitlab-haproxy']['ci']['api']['check_opts'] %> <%= node['gitlab-haproxy']['ci']['default_check_opts'] %> ssl verify none<%= @backend_servers['active']['canary_api'].key?(name) ? '' : ' backup' %>
<% end %>
<% end %>

backend ci_https_git
    mode http
    balance roundrobin
    option forwardfor
    option splice-auto
    timeout server-fin <%= node['gitlab-haproxy']['timeout_server_fin'] %>
<%= render 'partial_healthcheck.erb', :variables => {:ha_frontend => node['gitlab-haproxy']['ci']['https_git'], :ha_global => node['gitlab-haproxy']['global'] } -%>
<% @backend_servers['all']['https_git'].each do |name, ip| %>
    server <%= name %> <%= ip %>:443 <% if node['gitlab-haproxy']['ci']['use_weights'] %>weight <%= node['gitlab-haproxy']['ci']['https_git']['default_weight'] %> <% end %>check <%= node['gitlab-haproxy']['ci']['https_git']['check_opts'] %> <%= node['gitlab-haproxy']['ci']['default_check_opts'] %> ssl verify none<%= @backend_servers['active']['https_git'].key?(name) ? '' : ' backup' %>
<% end %>
<% if node['gitlab-haproxy']['ci']['use_weights'] %>
<% @backend_servers['all']['canary_https_git'].each do |name, ip| %>
    server <%= name %> <%= ip %>:443 <% if node['gitlab-haproxy']['ci']['use_weights'] %>weight <%= node['gitlab-haproxy']['ci']['canary_https_git']['default_weight'] %> <% end %>check <%= node['gitlab-haproxy']['ci']['https_git']['check_opts'] %> <%= node['gitlab-haproxy']['ci']['default_check_opts'] %> ssl verify none<%= @backend_servers['active']['canary_https_git'].key?(name) ? '' : ' backup' %>
<% end %>
<% end %>

<%if node['gitlab-haproxy']['ci']['enable_fallback'] == true %>
backend fallback_ci_api
    mode http
    balance roundrobin
    option forwardfor
    option splice-auto
    http-request set-header GitLab-CI-Fallback "api"
    http-response set-header GitLab-CI-Fallback "api"
    option splice-auto
    timeout server-fin <%= node['gitlab-haproxy']['timeout_server_fin'] %>
<%= render 'partial_healthcheck.erb', :variables => {:ha_frontend => node['gitlab-haproxy']['ci']['api'], :ha_global => node['gitlab-haproxy']['global'] } -%>
<% @backend_servers['all']['api'].each do |name, ip| %>
    server <%= name %> <%= ip %>:443 <% if node['gitlab-haproxy']['ci']['use_weights'] %>weight <%= node['gitlab-haproxy']['ci']['api']['default_weight'] %> <% end %>check <%= node['gitlab-haproxy']['ci']['api']['check_opts'] %> <%= node['gitlab-haproxy']['ci']['default_check_opts'] %> ssl verify none<%= @backend_servers['active']['api'].key?(name) ? '' : ' backup' %>
<% end %>
<% if node['gitlab-haproxy']['ci']['use_weights'] %>
<% @backend_servers['all']['canary_api'].each do |name, ip| %>
    server <%= name %> <%= ip %>:443 <% if node['gitlab-haproxy']['ci']['use_weights'] %>weight <%= node['gitlab-haproxy']['ci']['canary_api']['default_weight'] %> <% end %>check <%= node['gitlab-haproxy']['ci']['api']['check_opts'] %> <%= node['gitlab-haproxy']['ci']['default_check_opts'] %> ssl verify none<%= @backend_servers['active']['canary_api'].key?(name) ? '' : ' backup' %>
<% end %>
<% end %>

backend fallback_ci_https_git
    mode http
    balance roundrobin
    option forwardfor
    option splice-auto
    http-request set-header GitLab-CI-Fallback "git"
    http-response set-header GitLab-CI-Fallback "git"
    timeout server-fin <%= node['gitlab-haproxy']['timeout_server_fin'] %>
<%= render 'partial_healthcheck.erb', :variables => {:ha_frontend => node['gitlab-haproxy']['ci']['https_git'], :ha_global => node['gitlab-haproxy']['global'] } -%>
<% @backend_servers['all']['https_git'].each do |name, ip| %>
    server <%= name %> <%= ip %>:443 <% if node['gitlab-haproxy']['ci']['use_weights'] %>weight <%= node['gitlab-haproxy']['ci']['https_git']['default_weight'] %> <% end %>check <%= node['gitlab-haproxy']['ci']['https_git']['check_opts'] %> <%= node['gitlab-haproxy']['ci']['default_check_opts'] %> ssl verify none<%= @backend_servers['active']['https_git'].key?(name) ? '' : ' backup' %>
<% end %>
<% if node['gitlab-haproxy']['ci']['use_weights'] %>
<% @backend_servers['all']['canary_https_git'].each do |name, ip| %>
    server <%= name %> <%= ip %>:443 <% if node['gitlab-haproxy']['ci']['use_weights'] %>weight <%= node['gitlab-haproxy']['ci']['canary_https_git']['default_weight'] %> <% end %>check <%= node['gitlab-haproxy']['ci']['https_git']['check_opts'] %> <%= node['gitlab-haproxy']['ci']['default_check_opts'] %> ssl verify none<%= @backend_servers['active']['canary_https_git'].key?(name) ? '' : ' backup' %>
<% end %>
<% end %>
<% end %>

backend canary_ci_https_git
    mode http
    balance roundrobin
    option forwardfor
    option splice-auto
    timeout server-fin <%= node['gitlab-haproxy']['timeout_server_fin'] %>
<%= render 'partial_healthcheck.erb', :variables => {:ha_frontend => node['gitlab-haproxy']['ci']['https_git'], :ha_global => node['gitlab-haproxy']['global'] } -%>
<% @backend_servers['all']['canary_https_git'].each do |name, ip| %>
    server <%= name %> <%= ip %>:443 check <%= node['gitlab-haproxy']['ci']['https_git']['check_opts'] %> <%= node['gitlab-haproxy']['ci']['default_check_opts'] %> ssl verify none<%= @backend_servers['active']['canary_https_git'].key?(name) ? '' : ' backup' %>
<% end %>

backend canary_ci_api
    mode http
    balance roundrobin
    option forwardfor
    option splice-auto
    timeout server-fin <%= node['gitlab-haproxy']['timeout_server_fin'] %>
<%= render 'partial_healthcheck.erb', :variables => {:ha_frontend => node['gitlab-haproxy']['ci']['api'], :ha_global => node['gitlab-haproxy']['global'] } -%>
<% @backend_servers['all']['canary_api'].each do |name, ip| %>
    server <%= name %> <%= ip %>:443 check <%= node['gitlab-haproxy']['ci']['api']['check_opts'] %> <%= node['gitlab-haproxy']['ci']['default_check_opts'] %> ssl verify none<%= @backend_servers['active']['canary_api'].key?(name) ? '' : ' backup' %>
<% end %>
