<%= render 'boilerplate/frontend_definition.erb', :variables => {
  :name => 'kas',
  :bind_addresses => get_attribute('gitlab-haproxy', 'listen_addresses'),
  :bind_port=> get_attribute('gitlab-haproxy', flavor, 'kas', 'port'),
  :bind_extra_options => get_attribute('gitlab-haproxy', flavor, 'kas', 'bind_extra_options'),
  :listen_certificates => [
    '/etc/haproxy/ssl/kas.pem',
  ],
  :mode => 'http',
  :expect_proxy => 'TCP',
} -%>

<%= render 'boilerplate/http_front-end-security.erb' %>

  timeout http-request 5s

  stick-table type ipv6 size 1m expire 5m store gpc0,conn_rate(1m) <% if peers.any? %>peers <%= flavor %>-peers <% end %>

  ### Injected custom configuration ###########################################
<%= formatted_custom_config(get_attribute('gitlab-haproxy', flavor, 'kas', 'custom_config'), 2) %>
  ### End injected custom configuration #######################################

  acl is_k8s_proxy_path path_beg <%= get_attribute('gitlab-haproxy', flavor, 'kas', 'proxy_endpoint') %>
  ###############################################################
  # KAS routing rules
  # KAS main backends don't have weighted canary routing, like the https frontend.
  # Protocol-based routing
  # HTTP/2 traffic → kas_grpc backend (with proto h2 for gRPC)
  # HTTP/1.1 traffic → kas backend (without proto h2 for WebSocket)

  # K8s proxy routing (takes precedence over protocol-based routing)
  use_backend canary_kas_k8s_proxy if is_k8s_proxy_path canary_opt_in backend_available_canary_kas_k8s_proxy
  use_backend kas_k8s_proxy if is_k8s_proxy_path

  # HTTP/2 routing to gRPC backend
  # Canary phase: only canary-opted-in HTTP/2 traffic is routed to gRPC.
  # Main HTTP/2 traffic still falls through to the kas backend below until the
  # main cutover (follow-up MR adds `use_backend kas_grpc if is_http2`).
  acl is_http2 fc_http_major eq 2
  use_backend canary_kas_grpc if is_http2 canary_opt_in backend_available_canary_kas_grpc

  # Default HTTP/1.1 routing
  use_backend canary_kas if canary_opt_in backend_available_canary_kas
  use_backend kas
